# AgeOS deterministic chassis — copy to .env.local and fill in locally.
# Never commit .env.local. No real provider, model or payment credentials are
# used by this build: connectors are simulated and the assistant is scripted.

# Runtime connection (least-privilege role, RLS enforced, NOBYPASSRLS).
DATABASE_URL=postgres://ageos_app:CHANGE_ME@localhost:5432/ageos_dev
# Migrations and demo seed (owner role).
DATABASE_URL_MIGRATIONS=postgres://ageos_owner:CHANGE_ME@localhost:5432/ageos_dev

# Test databases. Must be a separate database whose name starts with ageos_test;
# the test setup refuses to run against the development database.
TEST_DATABASE_URL=postgres://ageos_app:CHANGE_ME@localhost:5432/ageos_test
TEST_DATABASE_URL_MIGRATIONS=postgres://ageos_owner:CHANGE_ME@localhost:5432/ageos_test

# Session signing secret: at least 32 random characters (e.g. `openssl rand -hex 32`).
AGEOS_SESSION_SECRET=
# Shared access code for the protected demo sign-in (at least 6 characters).
AGEOS_DEMO_ACCESS_CODE=

# Demo boundaries. These are the only supported values for this build.
AGEOS_DEMO_MODE=true
AGEOS_ASSISTANT_MODE=scripted
AGEOS_CONNECTOR_MODE=simulated
AGEOS_DEPLOYMENT_PROFILE=local

# Private file storage for uploaded evidence (outside public/).
AGEOS_STORAGE_DIR=.data/private-files

# Only needed to add new premium ReUI blocks with the shadcn CLI. Keep it in the
# shell environment, never in source or the browser bundle.
REUI_LICENSE_KEY=
